{
  "functions": {
    "api/v1/*.mjs": {
      "maxDuration": 10
    },
    "api/internal/*.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/internal/keeper",
      "schedule": "*/10 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/agent.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
